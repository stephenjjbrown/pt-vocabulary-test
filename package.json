{
  "name": "portuguese-vocabulary-web",
  "version": "1.0.0",
  "description": "Portuguese vocabulary estimator with Wilson-score confidence intervals per frequency bucket",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/index.ts",
    "dev": "concurrently -n server,vite -c blue,green \"node server/index.ts\" \"vite\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "preprocess": "node data/preprocess.cjs",
    "test": "node --test 'test/**/*.test.js'"
  },
  "keywords": [
    "portuguese",
    "vocabulary",
    "wilson-score",
    "language-learning"
  ],
  "author": "Stephen Brown",
  "license": "MIT",
  "dependencies": {
    "@preact/signals-core": "^1.8.0",
    "@stdlib/stats-binomial-test": "^0.2.3",
    "chart.js": "^4.5.1",
    "chartjs-chart-error-bars": "^4.4.5",
    "express": "^5.3.0",
    "lit": "^3.2.0",
    "wilson-score-rank": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-checker": "^0.14.5"
  }
}
